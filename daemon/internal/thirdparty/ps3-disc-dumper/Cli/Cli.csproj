<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cli is DiscEcho's own thin wrapper around the vendored Ps3DiscDumper
    library (see ../Ps3DiscDumper/Dumper.cs) -- not part of upstream
    13xforever/ps3-disc-dumper. Upstream ships only an Avalonia GUI
    project (UI.Avalonia); this gives the daemon something it can shell
    out to and parse stdout from, matching how it already drives
    redumper/HandBrake/MakeMKV.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ps3dumper-cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ps3DiscDumper\Ps3DiscDumper.csproj" />
  </ItemGroup>

</Project>
